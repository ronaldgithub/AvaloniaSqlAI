<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlitzIndexAI.ViewModels"
        xmlns:models="using:BlitzIndexAI.Models"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="BlitzIndexAI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BlitzIndex AI Analyzer"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="120" Height="10"
                             Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Title header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="BlitzIndex AI Analyzer"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="ronald.de.groot@opendata.nl"
                           FontSize="13"
                           Foreground="#AADDFF"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid ColumnDefinitions="290,*">

            <!-- Left panel: database + table selection -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>

                    <Button DockPanel.Dock="Bottom"
                            Content="Analyze Selected Table"
                            Command="{Binding AnalyzeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,8,0,0"/>

                    <StackPanel>
                        <TextBlock Text="Database" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Databases}"
                                  SelectedItem="{Binding SelectedDatabase}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Tables (dbo schema)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding Tables}"
                                 SelectedItem="{Binding SelectedTable}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Padding="2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Right panel: tabs -->
            <TabControl Grid.Column="1" Margin="10">

                <!-- Tab 1: AI Recommendations -->
                <TabItem Header="AI Recommendations">
                    <DockPanel>

                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="Review the recommendations above before executing."
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    Content="Execute SQL Script"
                                    Command="{Binding ExecuteSqlCommand}"
                                    HorizontalContentAlignment="Center"
                                    Padding="16,6"/>
                        </Grid>

                        <TextBox Text="{Binding AiResponse}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                 FontSize="13"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PlaceholderText="Select a database and table, then click 'Analyze Selected Table'..."/>
                    </DockPanel>
                </TabItem>

                <!-- Tab 2: Query Store -->
                <TabItem Header="Query Store">
                    <DockPanel>
                        <Button DockPanel.Dock="Top"
                                Content="Refresh"
                                Command="{Binding RefreshQueryStoreCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6"
                                Padding="12,4"/>
                        <DataGrid ItemsSource="{Binding QueryStoreResults}"
                                  SelectedItem="{Binding SelectedQueryStoreResult}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Query"       Binding="{Binding QueryText}"       Width="*"/>
                                <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount}"  Width="90"/>
                                <DataGridTextColumn Header="Avg LIO"     Binding="{Binding AvgLogicalReads}" Width="90"/>
                                <DataGridTextColumn Header="Avg ms"      Binding="{Binding AvgDurationMs}"   Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Tab 3: Benchmark -->
                <TabItem Header="Benchmark">
                    <DockPanel Margin="8">

                        <!-- Selected query display -->
                        <Border DockPanel.Dock="Top"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                Padding="6" Margin="0,0,0,8">
                            <TextBox Text="{Binding SelectedQueryStoreResult.QueryText, FallbackValue='← Select a query in the Query Store tab'}"
                                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                     FontSize="12"/>
                        </Border>

                        <!-- Step buttons -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="1. Run BEFORE"        Command="{Binding RunBeforeCommand}"/>
                            <Button Content="2. Execute Index"     Command="{Binding ExecuteSqlCommand}"/>
                            <Button Content="3. Update Statistics" Command="{Binding UpdateStatisticsCommand}"/>
                            <Button Content="4. Run AFTER"         Command="{Binding RunAfterCommand}"/>
                        </StackPanel>

                        <!-- Before / After grids -->
                        <Grid ColumnDefinitions="*,8,*">

                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="BEFORE" FontWeight="Bold" Margin="0,0,0,4"/>
                                <DataGrid ItemsSource="{Binding BeforeStats}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Table / Label"  Binding="{Binding Label}"          Width="*"/>
                                        <DataGridTextColumn Header="Logical Reads"  Binding="{Binding LogicalReads}"   Width="100"/>
                                        <DataGridTextColumn Header="Physical Reads" Binding="{Binding PhysicalReads}"  Width="100"/>
                                        <DataGridTextColumn Header="CPU ms"         Binding="{Binding CpuMs}"          Width="70"/>
                                        <DataGridTextColumn Header="Elapsed ms"     Binding="{Binding ElapsedMs}"      Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8"/>

                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="AFTER" FontWeight="Bold" Margin="0,0,0,4"/>
                                <DataGrid ItemsSource="{Binding AfterStats}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Table / Label"  Binding="{Binding Label}"          Width="*"/>
                                        <DataGridTextColumn Header="Logical Reads"  Binding="{Binding LogicalReads}"   Width="100"/>
                                        <DataGridTextColumn Header="Physical Reads" Binding="{Binding PhysicalReads}"  Width="100"/>
                                        <DataGridTextColumn Header="CPU ms"         Binding="{Binding CpuMs}"          Width="70"/>
                                        <DataGridTextColumn Header="Elapsed ms"     Binding="{Binding ElapsedMs}"      Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                        </Grid>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</Window>
